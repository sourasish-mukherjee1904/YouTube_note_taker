# ==========================================
# LectureLens Environment Configuration
# ==========================================

# Sarvam AI API Key (Required for high-fidelity Indian English / multilingual TTS and Sarvam LLM)
# Get your key at: https://sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Tavily AI Search API Key (Optional: DuckDuckGo search fallback is active if omitted)
# Get your key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# App URL for production deployment (defaults to localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
